# Optional. If set, step 2 skips sign-up and uses this key; step 3 requires a key.
# BLOCKVECTRA_API_KEY=rgw_...

# Optional, step 2 only: private key (0x-prefixed, 32 bytes) of a wallet used for sign-in.
# Keep it in your local environment only. Never commit it. If omitted, step 2 generates
# a throwaway wallet in memory for this run only.
# WALLET_PRIVATE_KEY=0x...
